          "expr": "(100 * sum by (network, scope) (sol_blocks_missed{scope=~\"${breakdown}:.*\",scope!~\"scope:.*\",network=~\"$network\"}) / clamp_min(sum by (network, scope) (sol_blocks_missed{scope=~\"${breakdown}:.*\",scope!~\"scope:.*\",network=~\"$network\"}) + sum by (network, scope) (sol_blocks_produced{scope=~\"${breakdown}:.*\",scope!~\"scope:.*\",network=~\"$network\"}), 1e-9)) - on (network) group_left() (100 * sum by (network) (sol_blocks_missed{scope=\"scope:all-network\",network=~\"$network\"}) / clamp_min(sum by (network) (sol_blocks_missed{scope=\"scope:all-network\",network=~\"$network\"}) + sum by (network) (sol_blocks_produced{scope=\"scope:all-network\",network=~\"$network\"}), 1e-9))",
