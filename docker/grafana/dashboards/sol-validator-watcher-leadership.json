    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether the leadership mode is disabled, pending its first result, failed its latest result, or succeeded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-gray",
                  "index": 0,
                  "text": "DISABLED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "UP"
                },
                "3": {
                  "color": "yellow",
                  "index": 3,
                  "text": "PENDING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "yellow",
                "value": 3
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(max(sol_mode_enabled{network=~\"$network\",mode=\"leadership\"}) * ((1 + max(sol_mode_up{network=~\"$network\",mode=\"leadership\"})) or vector(3))) or vector(0)",
          "instant": true,
          "legendFormat": "Leadership status",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Mode Status",
      "type": "stat"
    },
    {
      "datasource": {
