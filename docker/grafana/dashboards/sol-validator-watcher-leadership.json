      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sol_watched_validator_activated_stake_sol{network=~\"$network\"} / on (network) group_left clamp_min(max by (network) (sol_activated_stake_sol{scope=\"scope:all-network\",network=~\"$network\"}), 1e-9)",
