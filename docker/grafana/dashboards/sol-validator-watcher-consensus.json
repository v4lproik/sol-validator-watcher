      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sol_mode_command_route_info{network=~\"$network\",mode=\"consensus\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "{{mode}} / {{command}} / {{connector}}",
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
