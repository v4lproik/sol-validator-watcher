      "title": "Consensus Mode",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether the consensus mode is disabled, pending its first result, failed its latest result, or succeeded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-gray",
                  "index": 0,
                  "text": "DISABLED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "UP"
                },
                "3": {
                  "color": "yellow",
                  "index": 3,
                  "text": "PENDING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "yellow",
                "value": 3
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(max(sol_mode_enabled{network=~\"$network\",mode=\"consensus\"}) * ((1 + max(sol_mode_up{network=~\"$network\",mode=\"consensus\"})) or vector(3))) or vector(0)",
          "instant": true,
          "legendFormat": "Consensus status",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Mode Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Declared connector fallback order and API level versus the command minimum. Available reflects whether the configured transport and capabilities satisfy the route.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 4,
        "y": 1
