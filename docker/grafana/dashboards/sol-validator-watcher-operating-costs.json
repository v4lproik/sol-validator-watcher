  "panels": [
    {
      "collapsed": false,
      "description": "Operator-supplied completed-epoch budgets stay separate from protocol rewards. Start with collection state and snapshot age before reading retained values.",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Operating Cost Collection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "UNCONFIGURED means no operating-cost route is declared. PENDING means the route has not completed a successful economics poll. DOWN means the latest poll failed; retained budget values belong to the last successful snapshot.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-gray",
                  "index": 0,
                  "text": "UNCONFIGURED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "UP"
                },
                "3": {
                  "color": "yellow",
                  "index": 3,
                  "text": "PENDING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "yellow",
                "value": 3
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(max(sol_mode_command_route_info{network=\"$network\",mode=\"economics\",command=\"operating-costs\"}) * ((1 + max(sol_mode_up{network=\"$network\",mode=\"economics\"})) or vector(3))) or vector(0)",
          "instant": true,
          "legendFormat": "Operating-cost collection",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Collection Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Seconds since the latest complete watcher snapshot. This is whole-snapshot freshness, not invoice or billing-provider freshness.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min(time() - sol_last_successful_snapshot_timestamp_seconds{network=\"$network\"}, 0)",
          "instant": true,
          "legendFormat": "Snapshot age",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Snapshot Age",
      "type": "stat"
    },
