# Copy to .env.production, replace every placeholder, and chmod 600.
# Every image MUST use an immutable sha256 manifest digest.
SOL_WATCHER_IMAGE=ghcr.io/v4lproik/sol-validator-watcher@sha256:<digest>
PROMETHEUS_IMAGE=prom/prometheus@sha256:<digest>
GRAFANA_IMAGE=grafana/grafana@sha256:<digest>
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:<digest>

# Root-owned files outside the repository are recommended in production.
SOL_WATCHER_ENV_FILE=/etc/sol-validator-watcher/watcher.env
GRAFANA_ADMIN_PASSWORD_FILE=/etc/sol-validator-watcher/secrets/grafana-admin-password
ALERTMANAGER_WEBHOOK_URL_FILE=/etc/sol-validator-watcher/secrets/alertmanager-webhook-url
GRAFANA_ADMIN_USER=operator

WATCHER_MAINNET_METRICS_PORT=8003
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
ALERTMANAGER_HOST_PORT=9093
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
