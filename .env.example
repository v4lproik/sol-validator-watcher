# External validator watcher profile
SOL_WATCHER_NETWORK=external-validator
SOL_VALIDATOR_RPC_URL=http://host.docker.internal:8899
SOL_VALIDATOR_WS_URL=
SOL_WATCHER_RPC_TIMEOUT_SEC=30
SOL_WATCHER_WS_TIMEOUT_SEC=10
SOL_WATCHER_POLL_INTERVAL_SEC=15
SOL_WATCHER_COMMITMENT=confirmed
SOL_WATCHER_DELINQUENT_SLOT_DISTANCE=128

# Helius Devnet profile URL inputs
SOL_DEVNET_RPC_URL=
SOL_DEVNET_WS_URL=

# Mainnet profile template inputs
SOL_MAINNET_RPC_URL=
SOL_MAINNET_WS_URL=

# Grafana credentials for the compose stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local Surfpool stack host port mappings
SURFPOOL_HOST_RPC_PORT=18899
SURFPOOL_HOST_WS_PORT=18900
SURFPOOL_HOST_STUDIO_PORT=13000
WATCHER_SURFPOOL_METRICS_PORT=8000
WATCHER_VALIDATOR_METRICS_PORT=8001
WATCHER_DEVNET_METRICS_PORT=8002
WATCHER_MAINNET_METRICS_PORT=8003
